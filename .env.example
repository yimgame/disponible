# Copiá este archivo a .env y completá. NO subas el .env al repo.
# Contraseña del primer administrador (usuario "admin"); solo se usa la primera vez, con la base vacía. Al entrar pide cambiarla.
PANEL_ADMIN_PASSWORD=cambiame-por-una-larga
# PANEL_ADMIN_USER=admin
PUERTO=8140

# --- Integración con n8n / agentes de IA (opcional) ---
# Webhook saliente: a dónde mandar cada evento (movimiento, alerta_bloqueo, uso, uso_anulado). Varias URLs separadas por coma.
WEBHOOK_URL=
# Secreto para firmar los envíos (header X-Disponible-Firma: sha256=HMAC).
WEBHOOK_SECRET=
# Solo estos eventos (vacío = todos), ej. alerta_bloqueo,uso
WEBHOOK_EVENTOS=
# Llave de la API para agentes (/api/v1/...): Authorization: Bearer <llave>. Vacío = API apagada.
AGENTE_API_KEY=

# --- GCG (opcional) ---
# API key de la interfaz WS Trabajador de GCG: habilita la consulta en vivo por DNI en Consulta.
GCG_API_KEY=
